<?xml version="1.0"?>
<package format="3">
  <name>pid_controller</name>
  <version>2.0.0</version>
  <description>A basic PID controller (heading and lateral offset) for the Duckiebot.</description>
  <maintainer email="liam@duckietown.com">Liam</maintainer>
  <license>Duckietown License 2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>lx_ros2_tools</exec_depend>
  <exec_depend>encoder_pose</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
